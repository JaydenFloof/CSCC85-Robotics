#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/solids/protos/SolidBox.proto"

WorldInfo {
  contactProperties [
    ContactProperties {
      material1 "casterMaterial"
      material2 "floorMaterial"
      coulombFriction 0.001
      rollingFriction 0.0 0.0 0.0
    }
    ContactProperties {
      material1 "wheelMaterial"
      material2 "floorMaterial"
      coulombFriction 1.0
      rollingFriction 0.0 0.0 0.0
    }
  ]
  info [
    "A clean space for simulating robot localization/maze finding"
    "Modified from the webots tutorial [break_room]"
    "This script's walls are added programmatically from ***** (run that first!)"
    "We'll deal with the algorithms shortly..."
  ]
  title "Robot Localization"
}
Viewpoint {
  orientation 0.05609989985112882 0.5454480302194509 -0.8362650582000987 0.989720646915047
  position -8.62944061379169 10.375427587526874 8.819498421557848
}
TexturedBackground {
  texture "entrance_hall"
  luminosity 0.5
  skybox FALSE
}
TexturedBackgroundLight {
  texture "entrance_hall"
}
PointLight {
  location 0.0 0.0 5  
}
DEF FLOOR Floor {
  translation 0.0 0.0 0
#  rotation 0 0 1 1.5708
  size 7.7 12.86                              # This has to match the defined sizes in maze runner
  appearance Parquetry {
    type "light strip"
    textureTransform TextureTransform {
      rotation 1.0                            # 1D rotation for the texture image
      scale 0.4 0.4
    }
  }
}
# Side walls - easy peasy.
Wall {
  translation -3.85 0 0
  name "wall LEFT"
  size 0.06 12.86 2.5
  appearance Appearance {
        material Material {
          ambientIntensity .5
          diffuseColor 0 .5 1    # Example: Red color (R G B values between 0 and 1)
          transparency .5        # Value between 0 (fully opaque) and 1 (fully transparent)
        }
      }
}

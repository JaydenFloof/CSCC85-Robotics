# Modified from the Webots lidar robot example to provide a distance-enabled bot
# for localization and other tasks requiring distance sensors
DEF ROBOT Robot {
  # Robot's body
  children [
    Pose {
      translation 0 0 0.1245
      rotation 0 0 1 -1.570796
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.74902 0.74902 0.74902
            roughness 1
            metalness 0
          }
          geometry DEF BODY Cylinder {
            height 0.24
            radius 0.145		# Was .135
          }
        }
      ]
    }
    # Here is the LEFT wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.075
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          consumptionFactor 70
          maxVelocity 100                 # Mind the motor's parameters!
        }
        PositionSensor {
          name "left wheel sensor"
        }
      ]
      endPoint Solid {                    # The actual wheel shape, a thin cylindrical disk
        translation 0 0.150 0.075
        rotation 0.1344869543855967 -0.1344869543855967 -0.9817466670176034 1.589217
        children [
          DEF WHEEL Pose {
            rotation 0.577656895078166 0.5771968951617173 -0.5771968951617173 -2.093935
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.301961 0.301961 0.301961
                  roughness 1
                  metalness 0
                }
                geometry Cylinder {
                  height 0.07			# Was .03
                  radius 0.076			# Was .075
                }
              }
            ]
          }
        ]
        name "left wheel"
        boundingObject USE WHEEL
        physics DEF PHYSICS_WHEEL Physics {
          density -1
          mass 0.05
        }
        contactMaterial "wheelMaterial"
      }
    }
    # Here is the RIGHT wheel motor (re-uses definitions above from the left motor)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.075
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          consumptionFactor 70
          maxVelocity 100
        }
        PositionSensor {
          name "right wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.150 0.075
        rotation -0.06235700094427208 0.06235700094427208 -0.9961040150840033 1.5747
        children [
          USE WHEEL
        ]
        name "right wheel"
        boundingObject USE WHEEL
        physics USE PHYSICS_WHEEL
        contactMaterial "wheelMaterial"
      }
    }
    # LEFT - DISTANCE sensor (the two eyes on the robot thingie)
    DEF US0 DistanceSensor {
      translation 0.125 0.07 0.189               
      rotation 0 0 -1 -0.499205
      children [
        DEF SONAR_SENSOR Pose {
          rotation 0.577656895078166 0.5771968951617173 -0.5771968951617173 -2.093935
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0.301961 0.301961 0.301961
                roughness 1
                metalness 0
              }
              geometry Cylinder {
                height 0.01
                radius 0.024
              }
            }
          ]
        }
      ]
      name "us0"              # Not quite sure what this is. Probably important!
      lookupTable [
        0 0.7 0.01
        2 0 0
      ]
      type "sonar"
      numberOfRays 20
    }
    # RIGHT - DISTANCE sensor - reuses definitions from the left one
    DEF US1 DistanceSensor {
      translation 0.125 -0.07 0.189          
      rotation 0 0 1 -0.500795
      children [
        USE SONAR_SENSOR
      ]
      name "us1"
      lookupTable [
        0 0.7 0.1
        2 0 0
      ]
      type "sonar"
      numberOfRays 20
    }
    # The LIDAR sensor
    DEF LIDAR Lidar {
      translation 0 0 0.45              
      children [
        Transform {
          translation 0 0 -0.01
          rotation 0 0 -1 1.570796
          scale 6 5 3
          children [
            DEF STRUCTURE_AXES Shape {
              appearance Appearance {
                material Material {
                  diffuseColor 0.02 0.02 0.02
                }
              }
              geometry IndexedLineSet {       # These are the strust supporting the 
                coord Coordinate {            # sensor - the poins below are used to
                  point [                     # define endpoints for the 4 struts,
                    0 0 0.01                  # one common origin, 4 different endpoints
                    0.01 0 -0.08              # so 5 points and the coordIndex builds
                    -0.01 0 -0.08             # the lines
                    0 0.01 -0.08
                    0 -0.01 -0.08
                  ]
                }
                coordIndex [
                  0, 1, 0, 2, 0, 3, 0, 4
                ]
              }
            }
          ]
        }
      ]
      tiltAngle -0.1
      horizontalResolution 32          # Number of horizontal samples
      fieldOfView 3.14                 # Horizontal FOV
      numberOfLayers 1                 # Number of vertical slives
      near 0.05                        # Smallest distance
      minRange 0.05                    # Range
      maxRange 8
      type "fixed"                     # Either fixed or rotating 
      noise 0.1
      rotatingHead Solid {
        children [
          Pose {
            translation 0.03 0 0
            rotation 0 0 1 3.14159
            children [
              DEF LENS Shape {
                appearance PBRAppearance {
                  baseColor 0 0 0
                  roughness 1.1102230246251565e-16
                  metalness 0
                }
                geometry Sphere {
                  radius 0.015
                  subdivision 2
                }
              }
            ]
          }
          DEF CAMERA_SHAPE Pose {
            rotation -0.5771978956908259 0.5776548956082386 0.5771978956908259 -2.093935
            children [
              DEF CAMERA_OUTLINE Shape {
                appearance PBRAppearance {
                  baseColor 0.898039 0.898039 0.898039
                  roughness 1
                  metalness 0
                }
                geometry Cylinder {
                  height 0.06
                  radius 0.024
                }
              }
            ]
          }
        ]
      }
    }

    # Add two caster wheels to avoid the thing toppling over - this was
    # generated from Gemini and adapted to this bot, turns out we don't
    # need to worry about the material properties much, it works just
    # fine without making the fruction coefficients low.
     Solid {
        translation 0 .14 0.1           # Z is up, wheel is just below the body of the bot
        rotation 0 0 1 -1.570796
        name "front_caster_sphere"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.5 0.5 0.5 } # Grey caster
            geometry Sphere {
              radius 0.01               # Should touch the floor
            }
          }
        ]
        boundingObject USE SHAPE
        physics Physics {
          density -1
          mass 0.05 # Small mass for the caster
        }
        contactMaterial "casterMaterial"
      }
      Solid {
        translation 0 -.14 0.1           # Z is up, wheel is just below the body of the bot
        rotation 0 0 1 -1.570796
        name "rear_caster_sphere"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.5 0.5 0.5 } # Grey caster
            geometry Sphere {
              radius 0.01             
            }
          }
        ]
        boundingObject USE SHAPE
        physics Physics {
          density -1
          mass 0.05 # Small mass for the caster
        }
        contactMaterial "casterMaterial"
      }
        
  ]                             # Here ends the Robot's body's children
  name "MyBot"
  boundingObject Pose {
    translation 0 0 0.1245
    rotation 0 0 1 -1.570796
    children [
      USE BODY
    ]
  }
  physics Physics {
    density -1
    mass 1.5                   
    centerOfMass [
      0 0 0.15
    ]
  }
  controller "lidar"
  supervisor TRUE          # Make this robot a supervisor so we can manipulate the simulation
}
